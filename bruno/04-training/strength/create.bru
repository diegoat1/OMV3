meta {
  name: Create strength test
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/training/strength
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "peso_corporal": 75,
    "ejercicios": {
      "squat": { "peso": 100, "reps": 5 },
      "bench": { "peso": 80, "reps": 5 },
      "deadlift": { "peso": 120, "reps": 5 },
      "overhead_press": { "peso": 50, "reps": 5 },
      "row": { "peso": 70, "reps": 5 }
    }
  }
}

docs {
  Backend calcula 1RM con fórmula Epley: peso * (1 + reps/30).
}
