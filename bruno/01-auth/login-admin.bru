meta {
  name: Login (admin)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody() && res.getBody().success) {
    const data = res.getBody().data;
    bru.setEnvVar("token", data.token);
    bru.setEnvVar("userId", String(data.user.id));
    bru.setEnvVar("userDni", data.user.dni || "");
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("is_admin true", function() {
    expect(res.getBody().data.user.is_admin).to.equal(true);
  });
}
