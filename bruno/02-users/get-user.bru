meta {
  name: Get user
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/users/{{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Path param acepta auth user_id, DNI, o nombre_apellido. Por defecto usa {{userId}} de login.
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
