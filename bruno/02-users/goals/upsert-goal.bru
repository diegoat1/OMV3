meta {
  name: Create or update goal
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/users/{{userId}}/goals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "peso_objetivo": 72,
    "bf_objetivo": 12,
    "ffmi_objetivo": 22,
    "circ_abdomen_objetivo": 80,
    "circ_cintura_objetivo": 75,
    "circ_cadera_objetivo": 90,
    "tipo": "manual",
    "notas": "Objetivo seteado desde Bruno"
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
