meta {
  name: Auto goals (genetic limits)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/users/{{userId}}/goals/auto
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Calcula objetivos automáticos según límites genéticos. Requiere al menos una medición previa.
}

tests {
  test("status 200 or 404 (no measurements)", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
}
