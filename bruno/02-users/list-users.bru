meta {
  name: List users (admin)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/users?page=1&per_page=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  per_page: 20
  ~q:
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 200 or 403 (non-admin)", function() {
    expect([200, 403]).to.include(res.getStatus());
  });
}
